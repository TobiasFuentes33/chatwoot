# Documented automatically-wired variables for the Chatwoot Railway template.
# Every value is generated or auto-wired at deploy time — the one-click form
# has zero fields. Copy a line into the Railway dashboard only if you need to
# override it.

# Public URL of the deployment (auto-filled from the Railway domain).
FRONTEND_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}

# Random secret for Rails session/cookie signing (auto-generated, 64 chars).
# The worker reuses the web service's value via ${{chatwoot.SECRET_KEY_BASE}}.
SECRET_KEY_BASE=${{secret(64)}}

# PostgreSQL (companion service, auto-wired over the private network).
POSTGRES_HOST=${{postgres.RAILWAY_PRIVATE_DOMAIN}}
POSTGRES_PASSWORD=${{postgres.POSTGRES_PASSWORD}}
# Baked into the images: POSTGRES_PORT=5432, POSTGRES_USERNAME=postgres,
# POSTGRES_DATABASE=chatwoot_production. The entrypoint composes DATABASE_URL
# from these parts; set DATABASE_URL explicitly to override.

# Redis (companion service, auto-wired; no password — private network only).
REDIS_URL=redis://${{redis.RAILWAY_PRIVATE_DOMAIN}}:6379
